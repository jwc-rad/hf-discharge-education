# Copy to .env and edit. Dev and deployment differ only by this file.

# --- Dev: local vLLM (see docs/local_llm.md) ---
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=local-llm

# --- Deployment: SNUH LLM gateway ---
# LLM_BASE_URL=https://llm.snuh.org/llm
# LLM_API_KEY=<issued key>
# LLM_MODEL=<model name served by SNUH>

# json_schema (vLLM guided decoding) | json_object | none
LLM_STRUCTURED_OUTPUT=json_schema
LLM_TEMPERATURE=0
LLM_SEED=20260930
LLM_MAX_TOKENS=3000
LLM_TIMEOUT=300
# Server-specific extra body (JSON). Qwen3-family: disable thinking for JSON output.
LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# 1 = use the built-in fake LLM (demo/tests without a GPU)
LLM_FAKE=0

# Retrieval
RETRIEVAL_TOP_K=3
